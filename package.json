{
  "name": "brevo-agent-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "A catalog of Brevo business actions, built to be consumed by AI agents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:schema": "tsx scripts/build-schema.ts",
    "fetch:openapi": "tsx scripts/fetch-openapi.ts",
    "brevo:login": "tsx scripts/login.ts",
    "crawl": "tsx scripts/crawl.ts",
    "interact": "tsx scripts/interact.ts",
    "sanitize": "tsx scripts/sanitize.ts",
    "extract": "tsx scripts/extract.ts",
    "validate": "tsx scripts/validate.ts",
    "build:index": "tsx scripts/build-index.ts",
    "verify": "tsx scripts/verify.ts",
    "eval": "tsx scripts/eval-selection.ts",
    "build:docs": "tsx scripts/build-modules-doc.ts",
    "scan": "tsx scripts/scan-secrets.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
