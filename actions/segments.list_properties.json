{
  "id": "segments.list_properties",
  "module": "segments",
  "name": "List segment properties",
  "description": "Call this when you need to retrieve the full set of contact attributes (fields) that can be used when defining or editing a segment. Use contacts.get_contact if you only need the data of a specific contact instead of the attribute catalogue.",
  "preconditions": [],
  "inputs": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "outputs": {
    "type": "object",
    "properties": {
      "data": {
        "type": "object",
        "properties": {
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Human‑readable name of the attribute."
                },
                "field_key": {
                  "type": "string",
                  "description": "Internal key used for the attribute."
                },
                "dataType": {
                  "type": "string",
                  "enum": [
                    "email",
                    "text",
                    "category",
                    "number",
                    "date",
                    "boolean"
                  ],
                  "description": "Data type of the attribute."
                },
                "isDefault": {
                  "type": "boolean",
                  "description": "True if the attribute is a default system field.",
                  "default": false
                },
                "show": {
                  "type": "boolean",
                  "description": "Indicates whether the attribute is displayed in the UI.",
                  "default": false
                },
                "is_system_generated": {
                  "type": "boolean",
                  "description": "True if the attribute is generated by the system.",
                  "default": false
                },
                "catAttrib": {
                  "type": "object",
                  "description": "Mapping of category keys to their display values (present when dataType is 'category').",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "field",
                "field_key",
                "dataType"
              ]
            }
          }
        },
        "required": [
          "attributes"
        ]
      }
    },
    "required": [
      "data"
    ]
  },
  "side_effects": [],
  "destructive": false,
  "idempotent": true,
  "ui_path": [
    "Contacts",
    "Lists",
    "Segment properties"
  ],
  "internal_endpoint": {
    "method": "GET",
    "path": "/contact/backend/segment/properties",
    "body_example": null
  },
  "public_api": {
    "exists": false,
    "operationId": null
  },
  "plan_tier": "unknown",
  "verification": {
    "status": "observed",
    "evidence": [
      "captures/clean/contact-list.json"
    ],
    "verified_at": null
  }
}
