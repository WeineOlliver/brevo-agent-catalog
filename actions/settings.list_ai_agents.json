{
  "id": "settings.list_ai_agents",
  "module": "settings",
  "name": "List AI agents",
  "description": "Call this when you need to retrieve the list of AI agents available for the account, including their activation status and badge tier. Use a more specific endpoint (if one existed) to fetch details for a single agent when you only need information about that agent.",
  "preconditions": [],
  "inputs": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "outputs": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "parent": {
          "type": "string",
          "description": "The parent category for the AI agents."
        },
        "status": {
          "type": "boolean",
          "description": "Overall activation status of the AI feature group."
        },
        "agents": {
          "type": "array",
          "description": "List of individual AI agents and their properties.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Identifier of the AI agent (e.g., marketing, sales)."
              },
              "badge_name": {
                "type": "string",
                "description": "Tier badge indicating the plan level for the agent.",
                "enum": [
                  "free",
                  "pro"
                ]
              },
              "app_enabled": {
                "type": "boolean",
                "description": "Whether the agent is enabled in the current app context."
              },
              "status": {
                "type": "boolean",
                "description": "Whether the agent is active."
              }
            },
            "required": [
              "name",
              "badge_name",
              "app_enabled",
              "status"
            ]
          }
        }
      },
      "required": [
        "parent",
        "status",
        "agents"
      ]
    }
  },
  "side_effects": [],
  "destructive": false,
  "idempotent": true,
  "ui_path": [
    "Settings",
    "AI agents"
  ],
  "internal_endpoint": {
    "method": "GET",
    "path": "/settings/ai/agents",
    "body_example": null
  },
  "public_api": {
    "exists": false,
    "operationId": null
  },
  "plan_tier": "unknown",
  "verification": {
    "status": "observed",
    "evidence": [
      "captures/clean/campaigns-listing.json",
      "captures/clean/companies-settings.json",
      "captures/clean/companies.json"
    ],
    "verified_at": null
  }
}
