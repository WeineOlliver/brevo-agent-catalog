{
  "id": "automation.get_deferred_count",
  "module": "automation",
  "name": "Get deferred email count",
  "description": "Call this when you need the current number of deferred emails for automation processing, together with the processing status, rate limits, and any configured delay. Use the automation status endpoint instead if you only need the processing status without the deferred count details.",
  "preconditions": [],
  "inputs": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "outputs": {
    "type": "object",
    "properties": {
      "processingStatus": {
        "type": "string",
        "description": "Overall processing health status for automation.",
        "enum": [
          "Excellent",
          "Good",
          "Warning",
          "Critical"
        ]
      },
      "deferredEmailCount": {
        "type": "integer",
        "description": "Number of emails currently deferred."
      },
      "rateLimit": {
        "type": "integer",
        "description": "Maximum number of requests allowed per time window."
      },
