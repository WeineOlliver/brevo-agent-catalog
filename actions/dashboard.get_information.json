{
  "id": "dashboard.get_information",
  "module": "dashboard",
  "name": "Get dashboard information",
  "description": "Call this when you need to retrieve the current user's dashboard overview, including account details, plan, activated applications, and feature flags. Use a more specific endpoint such as \"account.get_details\" if you only need basic account metadata without the full dashboard payload.",
  "preconditions": [
    "The user must be authenticated."
  ],
  "inputs": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "outputs": {
    "type": "object",
    "properties": {
      "userInfo": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Unique identifier of the account."
          },
          "fname": {
            "type": "string",
            "description": "First name of the user."
          },
          "lname": {
            "type": "string",
            "description": "Last name of the user."
          },
          "email": {
            "type": "string",
            "description": "Email address of the user."
          },
          "isProfileComplete": {
            "type": "boolean",
            "description": "Whether the user's profile is complete."
          },
          "activatedApplications": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Brevo applications activated for the account."
          },
          "timezone": {
            "type": "string",
            "description": "Timezone configured for the account."
          },
          "isResellerParent": {
            "type": "boolean",
            "description": "Whether the account is a reseller parent."
          },
          "enterprise": {
            "type": "boolean",
            "description": "Whether the account has enterprise status."
          },
          "organizationId": {
            "type": "string",
            "description": "Identifier of the organization."
          },
          "isUnengagedSaved": {
            "type": "boolean",
            "description": "Whether unengaged contacts are saved."
          },
          "gtmEvent": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Google Tag Manager event flags."
          },
          "userUnvalidationStatus": {
            "type": "integer",
            "description": "Status code for user unvalidation."
          },
          "isDedicatedIpUser": {
            "type": "boolean",
            "description": "Whether the user has a dedicated IP."
          },
          "isContactImportAllowed": {
            "type": "boolean",
            "description": "Whether contact import is allowed."
          },
          "plan": {
            "type": "string",
            "enum": [
              "free",
              "starter",
              "business",
              "enterprise"
            ],
            "description": "Current subscription plan."
          },
          "isManagePlanAllowed": {
            "type": "boolean",
            "description": "Whether the user can manage their plan."
          },
          "isOwner": {
            "type": "boolean",
            "description": "Whether the user is the account owner."
          },
          "isPhoneOnboarded": {
            "type": "boolean",
            "description": "Whether phone onboarding is completed."
          },
          "isPhoneVerified": {
            "type": "boolean",
            "description": "Whether the phone number is verified."
          }
        },
        "required": []
      },
      "profileSkipped": {
        "type": "boolean",
        "description": "Whether the profile setup was skipped."
      },
      "conversionCurrency": {
        "type": "string",
        "description": "Currency used for conversion tracking."
      },
      "isConversionSetup": {
        "type": "boolean",
        "description": "Whether conversion tracking is set up."
      },
      "isMeetingsActive": {
        "type": "boolean",
        "description": "Whether the Meetings feature is active."
      },
      "isDealsActive": {
        "type": "boolean",
        "description": "Whether the Deals feature is active."
      },
      "isContactsListAllowed": {
        "type": "boolean",
        "description": "Whether contact list creation is allowed."
      }
    },
    "additionalProperties": true
  },
  "side_effects": [],
  "destructive": false,
  "idempotent": true,
  "ui_path": [
    "Dashboard",
    "Overview"
  ],
  "internal_endpoint": {
    "method": "GET",
    "path": "/dashboard-information",
    "body_example": null
  },
  "public_api": {
    "exists": false,
    "operationId": null
  },
  "plan_tier": "free",
  "verification": {
    "status": "observed",
    "evidence": [
      "captures/clean/root.json"
    ],
    "verified_at": null
  }
}
