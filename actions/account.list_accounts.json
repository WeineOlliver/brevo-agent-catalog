{
  "id": "account.list_accounts",
  "module": "account",
  "name": "List accounts",
  "description": "Call this when you need to retrieve the list of accounts accessible to the current user, such as when displaying company settings or the account overview. Use the get_account action for a single account if you only need details for a specific account.",
  "preconditions": [
    "The user must be authenticated."
  ],
  "inputs": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "outputs": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "description": "Unique identifier of the account."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email associated with the account."
        },
        "name": {
          "type": "object",
          "properties": {
            "familyName": {
              "type": "string",
              "description": "Family (last) name of the account owner."
            },
            "givenName": {
              "type": "string",
              "description": "Given (first) name of the account owner."
            }
          },
          "required": [
            "familyName",
            "givenName"
          ],
          "description": "Name details of the account owner."
        },
        "timezone": {
          "type": "string",
          "description": "Timezone identifier for the account (e.g., \"America/Sao_Paulo\")."
        },
        "locale": {
          "type": "string",
          "description": "Locale code for the account (e.g., \"en_US\")."
        },
        "memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "organization": {
                "type": "string",
                "description": "Identifier of the organization the account belongs to."
              },
              "rank": {
                "type": "string",
                "description": "Role of the account within the organization (e.g., \"owner\")."
              }
            },
            "required": [
              "organization",
              "rank"
            ]
          },
          "description": "List of organization memberships for the account."
        },
        "loginStatus": {
          "type": "boolean",
          "description": "Indicates whether the account is currently logged in."
        },
        "inactive": {
          "type": "boolean",
          "description": "Indicates whether the account is inactive."
        }
      },
      "required": [
        "_id",
        "email",
        "name",
        "timezone",
        "locale",
        "memberships",
        "loginStatus",
        "inactive"
      ]
    }
  },
  "side_effects": [],
  "destructive": false,
  "idempotent": true,
  "ui_path": [
    "Companies",
    "Settings"
  ],
  "internal_endpoint": {
    "method": "GET",
    "path": "/crm/backend/accounts",
    "body_example": null
  },
  "public_api": {
    "exists": false,
    "operationId": null
  },
  "plan_tier": "unknown",
  "verification": {
    "status": "observed",
    "evidence": [
      "captures/clean/companies-settings.json",
      "captures/clean/companies.json",
      "captures/clean/contact-index-id.json"
    ],
    "verified_at": null
  }
}
