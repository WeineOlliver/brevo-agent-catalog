{
  "id": "companies.get_organization_info",
  "module": "companies",
  "name": "Get organization info",
  "description": "Call this when you need to retrieve the current organization's activated applications and feature toggles from the Brevo CRM. If you only need specific feature toggle values, consider using a more focused endpoint (if available) rather than this comprehensive call.",
  "preconditions": [],
  "inputs": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "outputs": {
    "type": "object",
    "properties": {
      "activatedApplications": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "string",
            "description": "Unique identifier of the organization."
          },
          "Username": {
            "type": "string",
            "description": "Username associated with the organization."
          },
          "ActivatedApplications": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Name of an activated application (e.g., \"automation\", \"email-campaigns\", \"crm\")."
            },
            "description": "List of applications that are currently activated for the organization."
          },
          "ClientID": {
            "type": "integer",
            "description": "Internal client identifier."
          },
          "DateFormat": {
            "type": "string",
            "description": "Preferred date format for the organization."
          },
          "Locked": {
            "type": "boolean",
            "description": "Indicates whether the organization settings are locked."
          }
        },
        "required": [
          "ID",
          "Username",
          "ActivatedApplications",
          "ClientID",
          "DateFormat",
          "Locked"
        ]
      },
      "featureToggle": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled"
          ],
          "description": "Status of a specific feature toggle."
        },
        "description": "Map of feature toggle names to their enabled/disabled status."
      }
    },
    "required": [
      "activatedApplications",
      "featureToggle"
    ]
  },
  "side_effects": [],
  "destructive": false,
  "idempotent": true,
  "ui_path": [
    "Companies",
    "Settings"
  ],
  "internal_endpoint": {
    "method": "GET",
    "path": "/crm/backend/organization-info",
    "body_example": null
  },
  "public_api": {
    "exists": false,
    "operationId": null
  },
  "plan_tier": "unknown",
  "verification": {
    "status": "observed",
    "evidence": [
      "captures/clean/companies-settings.json",
      "captures/clean/companies.json",
      "captures/clean/crm-settings.json"
    ],
    "verified_at": null
  }
}
