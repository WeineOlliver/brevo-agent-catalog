{
  "id": "forms.get_account",
  "module": "forms",
  "name": "Get account information",
  "description": "Call this when you need to retrieve the current Brevo account details shown on the Forms subscription page. Use the authentication actions (e.g., login or token refresh) instead if the user is not already authenticated.",
  "preconditions": [
    "The user must be authenticated (valid session cookie or token)."
  ],
  "inputs": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "outputs": {
    "type": "object",
    "properties": {
      "organizationConfig": {
        "type": "object",
        "properties": {
          "organisationName": {
            "type": "string",
            "description": "Name of the organization."
          },
          "planTag": {
            "type": "string",
            "description": "Plan tier tag for the organization.",
            "enum": [
              "FREE",
              "STARTER",
              "BUSINESS",
              "ENTERPRISE"
            ]
          }
        },
        "required": [
          "organisationName",
          "planTag"
        ]
      },
      "currentAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Account identifier."
          },
          "email": {
            "type": "string",
            "description": "Email address of the account."
          },
          "locale": {
            "type": "string",
            "description": "Locale setting, e.g., en_US."
          },
          "timezone": {
            "type": "string",
            "description": "Timezone of the account."
          },
          "name": {
            "type": "string",
            "description": "Full name of the account holder."
          },
          "rank": {
            "type": "string",
            "description": "Rank/role of the user within the organization."
          },
          "mySqlId": {
            "type": "string",
            "description": "Internal MySQL identifier."
          }
        },
        "required": [
          "id",
          "email",
          "locale",
          "timezone",
          "name",
          "rank",
          "mySqlId"
        ]
      },
      "timezone": {
        "type": "string",
        "description": "Default timezone for the account."
      },
      "isSMTPEnabled": {
        "type": "boolean",
        "description": "Whether SMTP is enabled."
      },
      "transactionalStatus": {
        "type": "string",
        "description": "Status of transactional email verification."
      },
      "isSenderAvailable": {
        "type": "boolean",
        "description": "Whether a sender address is available."
      },
      "defaultCountryCode": {
        "type": "string",
        "description": "Default country code for the account."
      },
      "auth_token": {
        "type": "string",
        "description": "Authentication token for API calls."
      },
      "pricingVersion": {
        "type": "string",
        "description": "Version of the pricing model."
      },
      "companyIntegrationEnabled": {
        "type": "boolean",
        "description": "Whether company integrations are enabled."
      },
      "features": {
        "type": "object",
        "description": "Feature flags map.",
        "additionalProperties": true
      }
    },
    "required": [
      "organizationConfig",
      "currentAccount",
      "timezone",
      "isSMTPEnabled",
      "transactionalStatus",
      "isSenderAvailable",
      "defaultCountryCode",
      "auth_token",
      "pricingVersion",
      "companyIntegrationEnabled",
      "features"
    ]
  },
  "side_effects": [],
  "destructive": false,
  "idempotent": true,
  "ui_path": [
    "Contact",
    "Forms",
    "Subscription"
  ],
  "internal_endpoint": {
    "method": "GET",
    "path": "/forms-api/account",
    "body_example": null
  },
  "public_api": {
    "exists": false,
    "operationId": null
  },
  "plan_tier": "free",
  "verification": {
    "status": "observed",
    "evidence": [
      "captures/clean/contact-forms-app-subscription.json"
    ],
    "verified_at": null
  }
}
