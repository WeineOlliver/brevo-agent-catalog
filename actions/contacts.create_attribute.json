{
  "id": "contacts.create_attribute",
  "module": "contacts",
  "name": "Create contact attribute",
  "description": "Call this when you need to add a new custom attribute to contacts. If the attribute already exists, use the update attribute action instead.",
  "preconditions": [],
  "inputs": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "description": "Human‑readable name of the attribute."
      },
      "type": {
        "type": "string",
        "enum": [
          "text",
          "date",
          "float",
          "boolean",
          "category",
          "email",
          "url",
          "phone",
          "number",
          "price",
          "currency"
