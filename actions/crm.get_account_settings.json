    "type": "object",
    "properties": {},
    "required": []
  },
  "outputs": {
    "type": "object",
    "properties": {
      "ID": {
        "type": "string",
        "description": "Unique identifier of the account settings record."
      },
      "attributes": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "description": "Custom attributes defined for the account (empty if none)."
      },
      "account": {
        "type": "string",
        "description": "Identifier of the CRM account."
      },
      "LastAssignedAt": {
        "type": "string",
        "format": "date-time",
        "description": "Timestamp of the last assignment operation."
      },
      "NotificationSettings": {
        "type": "object",
        "properties": {
          "ContactAssignedNotification": {
            "type": "boolean"
          },
          "TaskAssignedNotification": {
            "type": "boolean"
          },
          "TaskEmailNotification": {
            "type": "boolean"
          },
          "TaskPushNotification": {
            "type": "boolean"
          },
          "WeeklyTasksReport": {
            "type": "boolean"
          },
          "DailyTasksReport": {
            "type": "boolean"
          },
          "WeeklyTasksReportTimeShift": {
            "type": "integer"
          }
        },
        "required": [
          "ContactAssignedNotification",
          "TaskAssignedNotification",
          "TaskEmailNotification",
          "TaskPushNotification",
          "WeeklyTasksReport",
          "DailyTasksReport",
          "WeeklyTasksReportTimeShift"
        ],
        "description": "User notification preferences."
      },
      "welcomeDone": {
        "type": "boolean",
        "description": "Whether the welcome tutorial has been completed."
      },
      "companyAttributesListView": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of company attribute keys displayed in the list view."
      },
      "companyAttributesPageView": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        },
