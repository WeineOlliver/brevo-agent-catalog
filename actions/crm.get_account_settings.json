      "dealAttributesPageView": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        },
        "description": "Deal attribute keys shown on the detail page."
      },
      "dealAttributesListView": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        },
        "description": "Deal attribute keys shown in the list view."
      },
      "taskAttributesListView": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        },
        "description": "Task attribute keys shown in the list view."
      },
      "salesStepper": {
        "type": "object",
        "properties": {
          "watchVideo": {
            "type": "boolean"
          },
          "adaptPipeline": {
            "type": "boolean"
          },
          "dealCreate": {
            "type": "boolean"
          },
          "taskCreate": {
            "type": "boolean"
          },
          "salesAutoma": {
            "type": "boolean"
          }
        },
        "required": [
          "watchVideo",
          "adaptPipeline",
          "dealCreate",
          "taskCreate",
          "salesAutoma"
        ],
