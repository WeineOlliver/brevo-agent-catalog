# Groq API key, used for the high-volume breadth extraction pass.
GROQ_API_KEY=
GROQ_MODEL=

# Identifiers belonging to the Brevo account used for capture. The sanitizer
# replaces these with placeholders. Never commit real values.
REDACT_EMAILS=
REDACT_ACCOUNT_IDS=

# Where a headed browser window opens. Left blank, every headed run probes the
# desktop and places the window on a non-primary screen, so a half-hour login
# or exploration run does not sit on the screen you are working on.
#   "x,y"     place the window at that desktop coordinate (negatives are valid)
#   primary   keep Chromium's default placement
BROWSER_WINDOW=
