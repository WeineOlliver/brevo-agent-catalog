{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {}
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {}
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "destructive": {
      "type": "boolean"
    },
    "idempotent": {
      "type": "boolean"
    },
    "ui_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "internal_endpoint": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "body_example": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "method",
            "path",
            "body_example"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "public_api": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "exists",
        "operationId"
      ],
      "additionalProperties": false
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "business",
        "enterprise",
        "unknown"
      ]
    },
    "verification": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "verified"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "status",
            "evidence",
            "verified_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "observed"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verified_at": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "evidence",
            "verified_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "inferred"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verified_at": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "evidence",
            "verified_at"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "module",
    "name",
    "description",
    "preconditions",
    "inputs",
    "outputs",
    "side_effects",
    "destructive",
    "idempotent",
    "ui_path",
    "internal_endpoint",
    "public_api",
    "plan_tier",
    "verification"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brevo-agent-catalog/schema/action.schema.json",
  "title": "Brevo business action"
}
